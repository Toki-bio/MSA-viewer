# Test inputs must reach users byte-for-byte: line endings (CRLF, CR-only) and
# byte-order marks are what some of these files exist to test.
examples/compat/** -text
examples/real/** -text

# Windows batch files: cmd.exe misreads labels and long lines in LF files, so they are checked out
# (and exported in archives such as the GitHub zip) with CRLF
*.bat text eol=crlf
